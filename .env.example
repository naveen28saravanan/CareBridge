# Optional local authentication API. Leave blank to use the fully functional local prototype adapter.
VITE_AUTH_API_URL=http://localhost:8787

# Supabase Database Configuration
VITE_SUPABASE_URL=https://dgedfbccshbwolcefdwa.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Live social sign-in entry URLs. These must point to secure server-side OAuth flows.
VITE_GOOGLE_AUTH_URL=
VITE_FACEBOOK_AUTH_URL=

# Optional zero-charge local language model. The safety engine works without it.
VITE_OLLAMA_URL=/ollama
VITE_OLLAMA_MODEL=gemma3:4b

# Server environment examples (set outside Vite/browser)
# CAREBRIDGE_API_PORT=8787
# CAREBRIDGE_WEB_ORIGIN=http://localhost:5173
# CAREBRIDGE_SESSION_HOURS=8
# CAREBRIDGE_DEV_OTP=true
# Firebase Authentication (Google Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ==========================================
# CareBridge One - Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# All keys below are REQUIRED unless marked [optional].
# ==========================================

# 1. API & Backend Configuration
VITE_AUTH_API_URL=http://localhost:8787
CAREBRIDGE_API_PORT=8787
CAREBRIDGE_WEB_ORIGIN=http://localhost:5173
CAREBRIDGE_SESSION_HOURS=8

# FIXED FINDING-08: Dev OTP must be EXPLICITLY set to true.
# Must be false or omitted in production.
CAREBRIDGE_DEV_OTP=false

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# 2. Database & Data Storage (Supabase)
VITE_SUPABASE_URL=<your-supabase-project-url>
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# 3. Google OAuth & Firebase Authentication
VITE_FIREBASE_API_KEY=<your-firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<your-project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<your-firebase-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<your-project>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<your-messaging-sender-id>
VITE_FIREBASE_APP_ID=<your-firebase-app-id>
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# 4. Meta WhatsApp Business Cloud API [optional]
WHATSAPP_ACCESS_TOKEN=<your-whatsapp-access-token>
WHATSAPP_PHONE_NUMBER_ID=<your-whatsapp-phone-number-id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<your-whatsapp-business-id>

# 5. WebRTC Telehealth [optional]
VITE_TURN_SERVER_URL=turn:turn.carebridge.org:3478
VITE_TURN_USERNAME=<your-turn-username>
VITE_TURN_CREDENTIAL=<your-turn-credential>

# 6. Emergency & Hospital Webhooks [optional]
EMERGENCY_DISPATCH_WEBHOOK_URL=https://api.carebridge.org/v1/emergency/dispatch
HOSPITAL_STATUS_FEED_URL=https://api.carebridge.org/v1/hospitals/availability

# FIXED FINDING-04: Seed passwords replaced with secure placeholders.
# Set strong unique values in your actual .env — never use the examples below.
# Minimum: 12+ characters, uppercase, lowercase, number, symbol.
SEED_PATIENT_PASSWORD=<strong-unique-password>
SEED_DOCTOR_PASSWORD=<strong-unique-password>
SEED_ADMIN_PASSWORD=<strong-unique-password>
